<?xml version="1.0" encoding="utf-8"?>
<!-- Animated launcher: red disc, white paper plane flies in from bottom-left. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <path android:fillColor="#C8102E" android:pathData="M54,4a50,50 0 1,1 0,100a50,50 0 1,1 0,-100z" />
            <group android:name="plane" android:pivotX="54" android:pivotY="54" android:translateX="-30" android:translateY="30" android:scaleX="0.4" android:scaleY="0.4">
                <path android:fillColor="#FFFFFF" android:pathData="M23,53.5 L84,27 L48.5,61.5 Z" />
                <path android:fillColor="#F6F1F1" android:pathData="M48.5,61.5 L84,27 L64.5,81.5 Z" />
                <path android:fillColor="#E9C9CC" android:pathData="M48.5,61.5 L50.5,79 L58.5,68.5 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="plane">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="700" android:valueFrom="-30" android:valueTo="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="translateY" android:duration="700" android:valueFrom="30" android:valueTo="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:duration="700" android:valueFrom="0.4" android:valueTo="1" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:duration="700" android:valueFrom="0.4" android:valueTo="1" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
